{
    "name": "phasync/swerve",
    "description": "S(w)erve your long-running PHP applications from the CLI fast and efficiently.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "phasync/phasync": "^2.0.0-beta7",
        "psr/log": "^3.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/simple-cache": "^2.0 || ^3.0",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "bin": [
        "bin/swerve"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Swerve\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "dev-master",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.0"
        }
    }
}
